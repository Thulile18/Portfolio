/* ================= GLOBAL STYLING ================= */

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Body Styling */
body{
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f4f4;
    color: #333;
}

/* ================= NAVIGATION ================= */

header{
    background-color: #111;
    padding: 20px 50px;
}

/* Navigation Bar */
nav{
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Logo */
.logo{
    color: white;
}

/* Navigation Links */
nav ul{
    display: flex;
    list-style: none;
}

/* Space Between Navigation Items */
nav ul li{
    margin-left: 20px;
}

/* Navigation Link Styling */
nav ul li a{
    color: white;
    text-decoration: none;
}

/* ================= HERO SECTION ================= */

.hero{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 80px 50px;
    flex-wrap: wrap;
}

/* Hero Text */
.hero-text{
    max-width: 500px;
}

/* Main Heading */
.hero-text h2{
    font-size: 40px;
    margin-bottom: 20px;
}

/* Paragraph Text */
.hero-text p{
    margin-bottom: 20px;
    line-height: 1.6;
}

/* Buttons */
.btn{
    display: inline-block;
    background-color: #111;
    color: white;
    padding: 12px 25px;
    text-decoration: none;
    border-radius: 5px;
    margin-right: 10px;
}

/* CV Button */
.cv-btn{
    background-color: #444;
}

/* Hero Image */
.hero-image img{
    width: 300px;
    border-radius: 10px;
}

/* ================= SKILLS SECTION ================= */

.skills{
    padding: 50px;
    text-align: center;
}

/* Skills Heading */
.skills h2{
    margin-bottom: 30px;
}

/* Skills Container */
.skills-container{
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

/* Skill Cards */
.card{
    background-color: white;
    padding: 20px;
    width: 250px;
    border-radius: 10px;
    box-shadow: 0px 2px 10px rgba(0,0,0,0.1);
}

/* ================= PROJECTS SECTION ================= */

.projects{
    padding: 50px;
    text-align: center;
}

/* Projects Container */
.projects-container{
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

/* Project Cards */
.project-card{
    background-color: white;
    width: 300px;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0px 2px 10px rgba(0,0,0,0.1);
}

/* Project Title */
.project-card h3{
    margin-bottom: 10px;
}

/* ================= PAGES ================= */

.page-content{
    padding: 60px 50px;
}

/* Page Heading */
.page-content h2{
    margin-bottom: 20px;
}

/* Paragraph Styling */
.page-content p{
    margin-bottom: 15px;
    line-height: 1.6;
}

/* ================= CONTACT FORM ================= */

form{
    display: flex;
    flex-direction: column;
    max-width: 500px;
}

/* Input Fields */
input,
textarea{
    margin-bottom: 15px;
    padding: 12px;
    border: 1px solid #ccc;
}

/* Submit Button */
button{
    background-color: #111;
    color: white;
    padding: 12px;
    border: none;
    cursor: pointer;
}

/* ================= FOOTER ================= */

footer{
    background-color: #111;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 50px;
}

/* Social Links */
.socials a{
    color: white;
    margin: 0 10px;
    text-decoration: none;
}